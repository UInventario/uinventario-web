{
  "name": "uinventario-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve uinventario-web",
    "start:v2": "ng serve uinventario-web-v2 --port 4300 --serve-path /v2",
    "build": "npm run build:v1 && npm run build:v2",
    "build:v1": "ng build uinventario-web",
    "build:v2": "ng build uinventario-web-v2",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"projects/**/*.{ts,html,css,scss,json,md}\" \"e2e/**/*.ts\" \"e2e-v2/**/*.ts\" \"scripts/**/*.mjs\" \"public/**/*.json\" .postcssrc.json angular.json ngsw-config.json package.json \"playwright*.ts\" \"*.mjs\"",
    "lint": "eslint \"src/**/*.ts\" \"projects/**/*.ts\" \"e2e-v2/**/*.ts\" \"scripts/**/*.mjs\" \"*.mjs\"",
    "watch": "ng build uinventario-web --watch --configuration development",
    "watch:v2": "ng build uinventario-web-v2 --watch --configuration development",
    "test": "ng test uinventario-web",
    "test:v2": "ng test uinventario-web-v2",
    "test:ci": "ng test uinventario-web --watch=false && ng test uinventario-web-v2 --watch=false",
    "test:server": "node --test server.spec.mjs",
    "test:e2e": "playwright test",
    "test:e2e:v2": "playwright test --config playwright.v2.config.ts",
    "test:service-worker": "node scripts/service-worker-smoke.mjs",
    "parity:generate": "node scripts/generate-api-parity-matrix.mjs",
    "parity:verify": "node scripts/verify-api-parity-matrix.mjs",
    "architecture:verify": "node --test scripts/verify-web-v2-architecture.spec.mjs && node scripts/verify-web-v2-architecture.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p projects/uinventario-web-v2/tsconfig.app.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.4",
    "@primeuix/themes": "^3.0.0",
    "primeng": "^22.1.0",
    "rxjs": "^7.8.2",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8"
  }
}
