{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/v2", "!/v2/**"],
  "assetGroups": [
    {
      "name": "uinventario-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.css", "/*.js"]
      }
    },
    {
      "name": "uinventario-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|png|jpg|jpeg|webp|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "runtime-config",
      "urls": ["/config.json"],
      "version": 1,
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "1d",
        "timeout": "2s"
      }
    }
  ]
}
